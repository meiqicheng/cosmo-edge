# CosmoEdge RK3588 Debian 11 (bullseye) cross-compilation build environment.
#
# Purpose: the production RK3588 device runs Debian 11 (glibc 2.31). The
# original cosmo_edge-build-env_rk3576 image is Ubuntu 22.04 (glibc 2.35),
# so packages built with it cannot start on the device (GLIBC_2.34/2.35
# missing). This image rebuilds the toolchain + third-party deps on the
# bullseye glibc baseline so the produced cosmo-engine runs on the device.
#
# Frozen inputs (do not bump casually; update builder-lock-rk3588.json in
# lockstep and record identities in /opt/cosmo/builder-versions.json):
#   - Base image: debian:bullseye pinned by digest.
#   - RKNN runtime 2.3.2 headers/lib copied from the digest-pinned rk3576
#     build image and verified by sha256 at build time.
#   - Debian 11 arm64 FFmpeg dev packages assembled into a self-contained
#     COSMO_FFMPEG_ROOT (/opt/ffmpeg-debian11) with their non-glibc
#     dependency closure, so cross builds link against a glibc-2.31
#     compatible media stack without touching prebuild/ffmpeg.
#
# SDK layout:
#   /opt/rknn               RKNN Runtime 2.3.2 (include/rknn_api.h, lib/librknnrt.so)
#   /opt/ffmpeg-debian11    {include,lib} Debian 11 arm64 FFmpeg + dep closure
#   /opt/cosmo/rockchip-builder-lock-rk3588.json   builder lock consumed by
#                           scripts/build_rockchip_package.sh --chip rk3588
#                           (via COSMO_ROCKCHIP_BUILDER_LOCK)
FROM debian:bullseye@sha256:99cdf7792e25416bd801861ccd8e2fb27fb527b25e8d9a8704ebc3ead2015675

ENV DEBIAN_FRONTEND=noninteractive

# amd64 host + arm64 cross targets (multiarch for arm64 ffmpeg dev packages).
# Use a China mirror (mirrors.tuna.tsinghua.edu.cn) for reliable downloads; the upstream
# deb.debian.org frequently returns 502 on this network. HTTP (not HTTPS) is
# used here because the base image has no ca-certificates yet; they are
# installed in Step 1. Retries + longer timeout cope with flaky mirror links.
# Slimming: merge every apt step into ONE layer and purge apt list/archive
# caches inside the same RUN, so they are never baked into the image.
# Step 1: host build tools (amd64). Step 2: aarch64 cross toolchain.
# Step 3: Debian 11 arm64 FFmpeg dev packages (glibc 2.31 compatible).
# liblzma5/libbz2 are linked by libavformat/libavcodec but, as required-
# priority packages, apt does not pull their arm64 variants automatically
# under multiarch; install them explicitly.
RUN sed -i 's|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g; s|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list \
    && printf 'Acquire::Retries "10";\nAcquire::http::Timeout "120";\nAcquire::http::ConnectionTimeout "60";\nAcquire::ftp::Timeout "120";\n' > /etc/apt/apt.conf.d/99-retries \
    && printf 'path-exclude /usr/share/doc/*\npath-include /usr/share/doc/*/copyright\npath-exclude /usr/share/man/*\npath-exclude /usr/share/locale/*\npath-exclude /usr/share/info/*\n' > /etc/dpkg/dpkg.cfg.d/01-nodoc \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg wget git make pkg-config \
        autoconf automake libtool bison flex nasm yasm \
        python3 python3-pip patch file \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu libc6-dev-arm64-cross \
    && apt-get install -y --no-install-recommends --fix-missing \
        libavcodec-dev:arm64 libavdevice-dev:arm64 libavfilter-dev:arm64 \
        libavformat-dev:arm64 libavutil-dev:arm64 \
        libswresample-dev:arm64 libswscale-dev:arm64 \
        liblzma5:arm64 libbz2-1.0:arm64 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# CMake: bullseye's 3.18.4 is too old for cryptopp (needs >= 3.20). Install a
# newer CMake via pip (lands in /usr/local/bin, ahead of /usr/bin in PATH).
RUN python3 -m pip install --no-cache-dir cmake==3.22.1 \
    && cmake --version | head -1

# Node.js 20 for the Vue3/Vite web frontend build (bullseye's node 12 is too
# old for Vite 6). Copy node from the existing rk3576 build image (it already
# has node v20.11.0 at /usr/local/node) instead of downloading - avoids flaky
# nodejs.org downloads on this network.
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/node /usr/local/node
ENV NODE_HOME=/usr/local/node \
    PATH=/usr/local/node/bin:$PATH
RUN node --version && npm --version

# Rust toolchain for tokenizers-c build. Copy rustup/cargo from the existing
# rk3576 build image (rustc/cargo 1.95.0 at /usr/local/cargo + /usr/local/rustup)
# instead of running rustup - avoids flaky downloads on this network.
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/cargo /usr/local/cargo
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN rustc --version && cargo --version

# Step 4: RKNN Runtime 2.3.2 from the digest-pinned rk3576 image. The runtime
# is cross-chip (RK3588 uses the same rknn_api.h / librknnrt.so); its sha256
# must match config/rknn/toolchain-lock.json (runtime.librknnrt_sha256).
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /opt/rknn /opt/rknn
RUN echo "d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8  /opt/rknn/lib/librknnrt.so" | sha256sum -c - \
    && test -f /opt/rknn/include/rknn_api.h

# Step 4b: stage RKLLM Runtime v1.3.0 (aarch64) so cmake/rkllm.cmake auto-enables
# the Qwen3.5 VLM backend for this image. Files come from .rk3588-build-cache
# (host-staged from the pinned rknn-llm-release-v1.3.0 runtime drop).
COPY .rk3588-build-cache/rkllm-runtime/include/rkllm.h /opt/rknn/include/rkllm.h
COPY .rk3588-build-cache/rkllm-runtime/lib/librkllmrt.so /opt/rknn/lib/librkllmrt.so
COPY .rk3588-build-cache/rkllm-runtime/LICENSE /opt/rknn/LICENSE
RUN test -f /opt/rknn/include/rkllm.h && test -f /opt/rknn/lib/librkllmrt.so \
    && test -f /opt/rknn/LICENSE

# Step 5: assemble a self-contained FFmpeg root for cross builds.
#
# Headers come from the multiarch dev packages; libraries are collected with
# their transitive dependency closure (resolved via arm64 readelf NEEDED),
# excluding glibc core libs and libstdc++/libgcc_s which the target device
# provides itself (the device is Debian 11 bullseye, same distro release as
# this build base, so its own copies are ABI-compatible).
RUN set -eux; \
    root=/opt/ffmpeg-debian11; \
    inc=/usr/include/aarch64-linux-gnu; \
    libdir=/usr/lib/aarch64-linux-gnu; \
    mkdir -p "$root/include" "$root/lib/pkgconfig"; \
    for h in libavcodec libavdevice libavfilter libavformat libavutil libswresample libswscale; do \
        cp -r "$inc/$h" "$root/include/"; \
    done; \
    cp "$inc"/libav*.h "$inc"/libsw*.h "$root/include/" 2>/dev/null || true; \
    cp "$libdir"/pkgconfig/libav*.pc "$libdir"/pkgconfig/libsw*.pc "$root/lib/pkgconfig/"; \
    copy_lib() { \
        name="$1"; \
        if [ -e "$root/lib/$name" ]; then return 0; fi; \
        src=""; \
        for d in "$libdir" /lib/aarch64-linux-gnu "$libdir/pulseaudio"; do \
            if [ -e "$d/$name" ]; then src="$d/$name"; break; fi; \
        done; \
        if [ -z "$src" ]; then echo "FATAL: arm64 library not found: $name" >&2; return 1; fi; \
        cp -L "$src" "$root/lib/$name"; \
        for dep in $(aarch64-linux-gnu-readelf -d "$root/lib/$name" | sed -n 's/.*Shared library: \[\(.*\)\]$/\1/p'); do \
            case "$dep" in \
                libc.so*|libm.so*|libdl.so*|libpthread.so*|librt.so*|libresolv.so*|libnsl.so*|libutil.so*|libanl.so*|libBrokenLocale.so*|libthread_db.so*|ld-linux-*|libgcc_s.so*|libstdc++.so*) ;; \
                *) copy_lib "$dep" ;; \
            esac; \
        done; \
    }; \
    for s in libavcodec.so.58 libavdevice.so.58 libavfilter.so.7 libavformat.so.58 libavutil.so.56 libswresample.so.3 libswscale.so.5; do \
        copy_lib "$s"; \
    done; \
    ln -sf libavcodec.so.58 "$root/lib/libavcodec.so"; \
    ln -sf libavdevice.so.58 "$root/lib/libavdevice.so"; \
    ln -sf libavfilter.so.7 "$root/lib/libavfilter.so"; \
    ln -sf libavformat.so.58 "$root/lib/libavformat.so"; \
    ln -sf libavutil.so.56 "$root/lib/libavutil.so"; \
    ln -sf libswresample.so.3 "$root/lib/libswresample.so"; \
    ln -sf libswscale.so.5 "$root/lib/libswscale.so"; \
    test -f "$root/include/libavcodec/avcodec.h"; \
    test -f "$root/lib/libavcodec.so.58"; \
    echo "--- /opt/ffmpeg-debian11/lib ---"; ls -la "$root/lib"

# Step 6: Rockchip MPP + RGA media sysroot (glibc 2.31 baseline).
#
# Versions are pinned by config/rockchip-media/runtime-lock.json profile
# "rk3588-mpp-1.1.0-rga-1.10.6-bullseye-v1":
#   - MPP  tag 1.1.0, commit c08762ebfadeb4e986d2fed993bc7a54862d3ebe
#     (same commit the RK3576 repro-v1 profile builds from; plain C++,
#     builds cleanly against bullseye g++-aarch64).
#   - librga official aarch64 prebuilt, commit 2b32edcb97b601b25683e2941d888c8515da6d55,
#     api_version 1.10.6_[3] — byte-identical to the file used on RK3576.
# Layout matches the rk3576 media root convention: {include,lib,share/licenses}.
# Media sources are pre-fetched on the host into .rk3588-build-cache/ and
# verified against the pinned commits there; the image build performs no
# network access for media artifacts (GitHub reachability is not assumed).
COPY .rk3588-build-cache/mpp-src /tmp/src/mpp
COPY .rk3588-build-cache/librga.so /tmp/assets/librga.so
COPY .rk3588-build-cache/librga-src/include/ /tmp/assets/rga-include/
COPY .rk3588-build-cache/librga-src/COPYING /tmp/assets/librga-COPYING

RUN set -eux; \
    root=/opt/rockchip-media/rk3588; \
    mkdir -p "$root/include/rockchip" "$root/include/rga" "$root/lib" "$root/share/licenses/rockchip-media/mpp" "$root/share/licenses/rockchip-media/librga"; \
    test "$(git -C /tmp/src/mpp rev-parse HEAD)" = "c08762ebfadeb4e986d2fed993bc7a54862d3ebe"; \
    cmake -S /tmp/src/mpp -B /tmp/src/mpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TEST=OFF; \
    cmake --build /tmp/src/mpp/build -j"$(nproc)"; \
    cp /tmp/src/mpp/build/mpp/librockchip_mpp.so* "$root/lib/"; \
    cd "$root/lib"; \
    real="$(readlink -f librockchip_mpp.so.1)"; \
    mv -f "$real" librockchip_mpp.so.0; \
    rm -f librockchip_mpp.so.1 librockchip_mpp.so; \
    ln -sf librockchip_mpp.so.0 librockchip_mpp.so.1; \
    ln -sf librockchip_mpp.so.1 librockchip_mpp.so; \
    echo "e150bda757fb5e8a649c429ec7cabaf851aa2a3be554ed494d5519e8790d943b  /tmp/assets/librga.so" | sha256sum -c -; \
    cp /tmp/assets/librga.so "$root/lib/librga.so"; \
    cp /tmp/assets/rga-include/*.h "$root/include/rga/"; \
    mkdir -p /tmp/src/mpp-headers && cp /tmp/src/mpp/inc/*.h /tmp/src/mpp-headers/; \
    cp /tmp/src/mpp/inc/*.h "$root/include/rockchip/"; \
    find /tmp/src/mpp/osal -name '*.h' | while read -r h; do rel="${h#/tmp/src/mpp/osal/}"; mkdir -p "$root/include/rockchip/$(dirname "$rel")"; cp "$h" "$root/include/rockchip/$rel"; done; \
    test -f "$root/include/rockchip/rk_mpi.h"; \
    test -f "$root/include/rga/im2d.h"; \
    test -f "$root/include/rga/im2d_type.h"; \
    test -L "$root/lib/librockchip_mpp.so.1"; \
    test -f "$root/lib/librockchip_mpp.so.0"; \
    aarch64-linux-gnu-readelf -d "$root/lib/librockchip_mpp.so.0" | grep -q 'soname.*librockchip_mpp\.so\.1'; \
    cp -r /tmp/src/mpp/LICENSES/. "$root/share/licenses/rockchip-media/mpp/"; \
    cp /tmp/assets/librga-COPYING "$root/share/licenses/rockchip-media/librga/COPYING"; \
    test -s "$root/share/licenses/rockchip-media/librga/COPYING"; \
    ls -la "$root/lib"

# Step 7: builder lock for the rk3588 package flow. The package script selects
# config/rockchip-build/builder-lock-rk3588.json from the repo tree and
# byte-compares it against the image-side copy resolved through this env var.
COPY config/rockchip-build/builder-lock-rk3588.json /opt/cosmo/rockchip-builder-lock-rk3588.json
ENV COSMO_ROCKCHIP_BUILDER_LOCK=/opt/cosmo/rockchip-builder-lock-rk3588.json

# Step 8: record frozen tool identities for evidence/reproducibility.
RUN set -eux; \
    python3 - <<'PYEOF'
import json, subprocess

def out(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()

ffmpeg_ver = out("dpkg-query -W -f='${Version}' libavcodec58:arm64")
record = {
    "base_image": "debian:bullseye@sha256:99cdf7792e25416bd801861ccd8e2fb27fb527b25e8d9a8704ebc3ead2015675",
    "sdk_source_image": "ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348",
    "rknn_runtime_sha256": "d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8",
    "rknn_include_header": "/opt/rknn/include/rknn_api.h",
    "ffmpeg_root": "/opt/ffmpeg-debian11",
    "ffmpeg_deb_version_arm64": ffmpeg_ver,
    "cmake": out("cmake --version | head -1"),
    "cross_gcc": out("aarch64-linux-gnu-gcc --version | head -1"),
    "node": out("node --version"),
    "rustc": out("rustc --version"),
    "cargo": out("cargo --version"),
    "glibc_baseline": "2.31",
}
with open("/opt/cosmo/builder-versions-rk3588.json", "w") as f:
    json.dump(record, f, indent=2)
print(json.dumps(record, indent=2))
PYEOF

WORKDIR /workspace

