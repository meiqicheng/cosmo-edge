# CosmoEdge RK3588 Debian 11 (bullseye) cross-compilation build environment.
#
# Purpose: the production RK3588 device runs Debian 11 (glibc 2.31). The
# original cosmo_edge-build-env_rk3576 image is Ubuntu 22.04 (glibc 2.35),
# so packages built with it cannot start on the device (GLIBC_2.34/2.35
# missing). This image rebuilds the toolchain + third-party deps on the
# bullseye glibc baseline so the produced cosmo-engine runs on the device.
#
# SDK layout mirrors cosmo_edge-build-env_rk3576:
#   /opt/rknn             RKNN Runtime (devlibs/rknpu2, cross-chip)
#   /opt/rkllm            RKLLM Runtime + LICENSE (devlibs/rkllm)
#   /opt/rockchip-media   MPP/RGA (use the newer image-bundled headers;
#                         devlibs' MPP is too old - missing mpp_buffer_sync_*)
#   /usr/lib/aarch64-linux-gnu  Debian 11 arm64 ffmpeg (glibc 2.31 compatible)
#
# The image must be built with the SDK directories mounted or copied in.
FROM debian:bullseye

ENV DEBIAN_FRONTEND=noninteractive

# amd64 host + arm64 cross targets (multiarch for arm64 ffmpeg dev packages).
# Use a China mirror (mirrors.ustc.edu.cn) for reliable downloads; the upstream
# deb.debian.org frequently returns 502 on this network. HTTP (not HTTPS) is
# used here because the base image has no ca-certificates yet; they are
# installed in Step 1. Retries + longer timeout cope with flaky mirror links.
RUN sed -i 's|http://deb.debian.org/debian-security|http://mirrors.ustc.edu.cn/debian-security|g; s|http://deb.debian.org/debian|http://mirrors.ustc.edu.cn/debian|g' /etc/apt/sources.list \
    && printf 'Acquire::Retries "10";\nAcquire::http::Timeout "120";\nAcquire::http::ConnectionTimeout "60";\nAcquire::ftp::Timeout "120";\n' > /etc/apt/apt.conf.d/99-retries \
    && dpkg --add-architecture arm64 && apt-get update

# Step 1: host build tools (amd64)
RUN apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg wget git make cmake pkg-config \
        autoconf automake libtool bison flex nasm yasm \
        python3 python3-pip patch file

# Step 2: aarch64 cross toolchain
RUN apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu libc6-dev-arm64-cross

# CMake: bullseye's 3.18.4 is too old for cryptopp (needs >= 3.20). Install a
# newer CMake via pip (lands in /usr/local/bin, ahead of /usr/bin in PATH).
RUN python3 -m pip install --no-cache-dir cmake==3.22.1 \
    && cmake --version | head -1

# Step 3: Debian 11 arm64 FFmpeg dev packages (glibc 2.31 compatible)
RUN apt-get install -y --no-install-recommends --fix-missing \
        libavcodec-dev:arm64 libavdevice-dev:arm64 libavfilter-dev:arm64 \
        libavformat-dev:arm64 libavutil-dev:arm64 \
        libswresample-dev:arm64 libswscale-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 for the Vue3/Vite web frontend build (bullseye's node 12 is too
# old for Vite 6). Copy node from the existing rk3576 build image (it already
# has node v20.11.0 at /usr/local/node) instead of downloading - avoids flaky
# nodejs.org downloads on this network.
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/node /usr/local/node
ENV NODE_HOME=/usr/local/node \
    PATH=/usr/local/node/bin:$PATH
RUN node --version && npm --version

# Rust toolchain for tokenizers-c build. Copy rustup/cargo from the existing
# rk3576 build image (rustc/cargo 1.95.0 at /usr/local/cargo + /usr/local/rustup)
# instead of running rustup - avoids flaky downloads on this network.
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/cargo /usr/local/cargo
COPY --from=ghcr.io/cosmo-wander-ai/cosmo_edge-build-env_rk3576@sha256:135d25d0baf14e7918726f7efb040a0627926aedd5825f52fab6c1cd208da348 /usr/local/rustup /usr/local/rustup
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN rustc --version && cargo --version

# Placeholders for SDK mounts (created so later layers can reference them)
RUN mkdir -p /opt/rknn /opt/rkllm /opt/rockchip-media

WORKDIR /workspace
