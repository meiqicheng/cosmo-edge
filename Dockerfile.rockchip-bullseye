# CosmoEdge multi-chip Rockchip Debian 11 (bullseye) cross-compilation build
# environment.
#
# Purpose: the production Rockchip devices (RK3576 / RV1126B / RK3588) run
# Debian 11 (glibc 2.31). The original cosmo_edge-build-env_rk3576 image is
# Ubuntu 22.04 (glibc 2.35), so packages built with it cannot start on the
# device (GLIBC_2.34/2.35 missing). This image rebuilds the toolchain +
# third-party deps on the bullseye glibc baseline so the produced
# cosmo-engine runs on the device. It builds all three Rockchip targets in one
# image using a multi-stage git-clone + media-verify + RKLLM structure.
#
# Everything is assembled FROM SCRATCH on the bullseye base — no file is
# copied from the legacy rk3576 image (no COPY --from=...rk3576...):
#   - Node.js 20    downloaded from npmmirror, verified by SHASUMS256.txt
#   - Rust 1.95.0   installed with rustup from rsproxy.cn
#   - RKNN 2.3.2    downloaded from the pinned rknn-toolkit2 commit, sha256
#                   verified against config/rknn/toolchain-lock.json
#   - FFmpeg 4.4.6  cross-compiled from the official LGPL source release
#                   (--disable-gpl), installed into /opt/ffmpeg-debian11
#                   (glibc 2.31). No GPL-licensed components are enabled, so
#                   the packaged libavcodec identifies as LGPL-2.1-or-later
#                   and matches the shipped COPYING.LGPLv2.1 (P1-6: no
#                   GPL-binary-under-LGPL waiver is needed).
#   - MPP/RGA       cross-compiled from pinned sources (glibc 2.31)
#   - RKLLM         downloaded by scripts/install_rkllm_sdk.py (sha256 pinned)
#
# Frozen inputs (do not bump casually; update config/rockchip-build/builder-lock.json
# in lockstep and record identities in /opt/cosmo/builder-versions.json):
#   - Base image: debian:bullseye pinned by digest.
#   - FFmpeg 4.4.6 official release tarball (ffmpeg.org) pinned by SHA-256,
#     cross-compiled with --disable-gpl into a self-contained COSMO_FFMPEG_ROOT
#     (/opt/ffmpeg-debian11) with its non-glibc dependency closure, so cross
#     builds link against a glibc-2.31 compatible media stack without touching
#     prebuild/ffmpeg.
#
# SDK layout:
#   /opt/rknn               RKNN Runtime 2.3.2 (include/rknn_api.h, lib/librknnrt.so)
#   /opt/ffmpeg-debian11    {include,lib} FFmpeg 4.4.6 LGPL cross build + dep closure
#   /opt/rockchip-media/<chip>   MPP/RGA media sysroot per chip (glibc 2.31)
#   /opt/rkllm              RKLLM Runtime 1.3.0 (include/rkllm.h, lib/librkllmrt.so)
#   /usr/local/node         Node.js 20 (Vue3/Vite frontend build)
#   /usr/local/cargo+rustup Rust 1.95.0 (tokenizers-c build)
#   /opt/cosmo/rockchip-builder-lock.json   builder lock consumed by
#                           scripts/build_rockchip_package.sh --chip <chip>
#                           (via COSMO_ROCKCHIP_BUILDER_LOCK)
#
# Targets (all three chips, one image; pick with --chip / COSMO_TARGET_CHIP):
#   rk3576  rv1126b  rk3588
#
# The MPP/RGA media sysroot is chip-independent aarch64 (same source, same
# aarch64-linux-gnu cross toolchain on bullseye), so it is compiled ONCE and
# fanned out to the per-chip roots under the shared runtime profile
# "mpp-1.1.0-rga-1.10.6-bullseye-v1" (ELF machine/soname + glibcMax 2.31).
# The RV1126B root additionally carries a sealed manifest because its
# platform profile requires one (require_sealed_sysroot=true).
#
# Stages:
#   rockchip-toolchain         base toolchain + RKNN + FFmpeg root (glibc 2.31)
#   media-build  git-clone + cross-build MPP/RGA -> /opt/rockchip-media/shared
#   media-verify fan out media to 3 chip roots, seal RV1126B, verify each
#   builder      (final) media + RKLLM + builder lock + version record


ARG ROCKCHIP_LEGACY_BASE=debian:bullseye@sha256:99cdf7792e25416bd801861ccd8e2fb27fb527b25e8d9a8704ebc3ead2015675

FROM ${ROCKCHIP_LEGACY_BASE} AS rockchip-toolchain

# Pinned source revisions. MPP/RGA match the shared bullseye runtime profile
# "mpp-1.1.0-rga-1.10.6-bullseye-v1" in config/rockchip-media/runtime-lock.json.
# RKNN_COMMIT is the rknn-toolkit2 v2.3.2 tag (config/rknn/toolchain-lock.json
# source.tag_sha). FFmpeg is the official ffmpeg.org 4.4.6 release tarball
# (sha256 2290461f...; same version as the x86_64/Sophon prebuild roots),
# cross-compiled with --disable-gpl. Global ARGs so
# every stage can resolve them.
ARG MPP_REVISION=c08762ebfadeb4e986d2fed993bc7a54862d3ebe
ARG RGA_REVISION=2b32edcb97b601b25683e2941d888c8515da6d55
ARG RKNN_COMMIT=42aa1d426c0a9e0869b6374edba009f7208a1926
ARG FFMPEG_VERSION=4.4.6
ARG FFMPEG_TARBALL_SHA256=2290461f467c08ab801731ed412d8e724a5511d6c33173654bd9c1d2e25d0617
ARG NODE_VERSION=v20.11.0
ARG RUST_VERSION=1.95.0


FROM rockchip-toolchain AS rockchip-common

ENV DEBIAN_FRONTEND=noninteractive

# amd64 host + arm64 cross targets (multiarch for the arm64 build deps used
# when cross-compiling FFmpeg 4.4.6 from source below).
# Use a China mirror (mirrors.tuna.tsinghua.edu.cn) for reliable downloads; the upstream
# deb.debian.org frequently returns 502 on this network. HTTP (not HTTPS) is
# used here because the base image has no ca-certificates yet; they are
# installed in Step 1. Retries + longer timeout cope with flaky mirror links.
# Slimming: merge every apt step into ONE layer and purge apt list/archive
# caches inside the same RUN, so they are never baked into the image.
# Step 1: host build tools (amd64). Step 2: aarch64 cross toolchain.
# Step 3: arm64 dev libraries for the FFmpeg source build. Debian 11 arm64
# FFmpeg binary packages are NOT used: the official Debian build enables GPL
# components (libx264), which would make the packaged libavcodec GPL while the
# shipped license text claims LGPL (P1-6). The arm64 -dev packages below only
# provide the optional non-GPL libraries (zlib/bz2/lzma/openssl) that the
# self-built LGPL FFmpeg links against; the device gets the matching runtime
# libraries through the dependency closure collected in Step 5.
RUN sed -i 's|http://deb.debian.org/debian-security|http://mirrors.tuna.tsinghua.edu.cn/debian-security|g; s|http://deb.debian.org/debian|http://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list \
    && printf 'Acquire::Retries "10";\nAcquire::http::Timeout "120";\nAcquire::http::ConnectionTimeout "60";\nAcquire::ftp::Timeout "120";\n' > /etc/apt/apt.conf.d/99-retries \
    && printf 'path-exclude /usr/share/doc/*\npath-include /usr/share/doc/*/copyright\npath-exclude /usr/share/man/*\npath-exclude /usr/share/locale/*\npath-exclude /usr/share/info/*\n' > /etc/dpkg/dpkg.cfg.d/01-nodoc \
    && dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg wget git make pkg-config \
        autoconf automake libtool bison flex nasm yasm \
        python3 python3-pip patch file \
        binutils gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
        binutils-aarch64-linux-gnu libc6-dev-arm64-cross \
    && apt-get install -y --no-install-recommends --fix-missing \
        zlib1g-dev:arm64 libssl-dev:arm64 \
        libbz2-dev:arm64 liblzma-dev:arm64 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# CMake: bullseye's 3.18.4 is too old for cryptopp (needs >= 3.20). Install a
# newer CMake via pip (lands in /usr/local/bin, ahead of /usr/bin in PATH).
RUN python3 -m pip install --no-cache-dir cmake==3.22.1 \
    && cmake --version | head -1

# Node.js 20 for the Vue3/Vite web frontend build (bullseye's node 12 is too
# old for Vite 6). Downloaded from the npmmirror mirror (nodejs.org is flaky
# on this network) and verified against the official SHASUMS256.txt. No
# dependency on the legacy rk3576 build image.
RUN set -eux; \
    curl -fsSL -o /tmp/node.tar.xz \
      "https://npmmirror.com/mirrors/node/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz"; \
    curl -fsSL "https://npmmirror.com/mirrors/node/${NODE_VERSION}/SHASUMS256.txt" \
      | grep -F "node-${NODE_VERSION}-linux-x64.tar.xz" > /tmp/node.sha256; \
    (cd /tmp && sha256sum -c node.sha256); \
    mkdir -p /usr/local/node; \
    tar -xJf /tmp/node.tar.xz -C /usr/local/node --strip-components=1; \
    rm -f /tmp/node.tar.xz /tmp/node.sha256
ENV NODE_HOME=/usr/local/node \
    PATH=/usr/local/node/bin:$PATH
RUN node --version && npm --version

# Rust toolchain for tokenizers-c build. Installed from scratch with rustup
# via the rsproxy.cn mirror (static.rust-lang.org is flaky on this network).
# Pinned to the same toolchain version the legacy image shipped (1.95.0).
RUN set -eux; \
    curl -fsSL -o /tmp/rustup-init \
      "https://rsproxy.cn/rustup/dist/x86_64-unknown-linux-gnu/rustup-init"; \
    chmod +x /tmp/rustup-init; \
    CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup \
    RUSTUP_DIST_SERVER=https://rsproxy.cn RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup \
      /tmp/rustup-init -y --no-modify-path --profile minimal \
      --default-toolchain "${RUST_VERSION}" \
      --target x86_64-unknown-linux-gnu; \
    rm -f /tmp/rustup-init
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN rustc --version && cargo --version

# Step 4: RKNN Runtime 2.3.2 downloaded from the pinned rknn-toolkit2 commit
# (raw.githubusercontent.com; the same source the legacy image's copy came
# from). The runtime is cross-chip (all Rockchip targets use the same
# rknn_api.h / librknnrt.so); sha256 values must match
# config/rknn/toolchain-lock.json (runtime.librknnrt_sha256 / rknn_api_header_sha256).
RUN set -eux; \
    mkdir -p /opt/rknn/include /opt/rknn/lib; \
    curl -fsSL -o /opt/rknn/lib/librknnrt.so \
      "https://raw.githubusercontent.com/airockchip/rknn-toolkit2/${RKNN_COMMIT}/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so"; \
    curl -fsSL -o /opt/rknn/include/rknn_api.h \
      "https://raw.githubusercontent.com/airockchip/rknn-toolkit2/${RKNN_COMMIT}/rknpu2/runtime/Linux/librknn_api/include/rknn_api.h"; \
    echo "d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8  /opt/rknn/lib/librknnrt.so" | sha256sum -c -; \
    echo "c48e11a6f41b451a5fd1e4ad774ea60252d3d94f78bee9b21ea3d21b21deba9a  /opt/rknn/include/rknn_api.h" | sha256sum -c -

# Step 5: assemble a self-contained FFmpeg root for cross builds.
#
# FFmpeg 4.4.6 is cross-compiled from the official ffmpeg.org release tarball
# with --disable-gpl (no libx264/x265 or any other GPL-only external library),
# so the packaged libavcodec identifies as "LGPL version 2.1 or later" and
# matches the shipped COPYING.LGPLv2.1 — the same license posture as the
# x86_64/Sophon prebuild roots (P1-6). Optional non-GPL system libraries
# (zlib/bz2/lzma/openssl) are enabled via the arm64 -dev packages from Step 3.
# Configure flags follow the FFmpeg cross-build pattern used by AXERA's
# axcl-runtime 3rdparty/ffmpeg/build.sh (--enable-cross-compile,
# --cross-prefix, --arch=aarch64, --target-os=linux, --cc).
#
# After `make install` the libraries are collected with their transitive
# dependency closure (resolved via arm64 readelf NEEDED), excluding glibc
# core libs and libstdc++/libgcc_s which the target device provides itself
# (the device is Debian 11 bullseye, same distro release as this build base,
# so its own copies are ABI-compatible).
RUN set -eux; \
    curl -fsSL -o /tmp/ffmpeg.tar.xz \
      "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"; \
    echo "${FFMPEG_TARBALL_SHA256}  /tmp/ffmpeg.tar.xz" | sha256sum -c -; \
    mkdir -p /tmp/ffmpeg; \
    tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1; \
    rm -f /tmp/ffmpeg.tar.xz; \
    cd /tmp/ffmpeg; \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    ./configure \
      --prefix=/opt/ffmpeg-debian11 \
      --enable-cross-compile \
      --cross-prefix=aarch64-linux-gnu- \
      --arch=aarch64 \
      --target-os=linux \
      --cc=aarch64-linux-gnu-gcc \
      --enable-shared --disable-static \
      --disable-gpl --disable-nonfree \
      --disable-doc --disable-programs --disable-debug \
      --enable-avcodec --enable-avdevice --enable-avfilter \
      --enable-avformat --enable-avutil \
      --enable-swscale --enable-swresample \
      --enable-openssl \
      --enable-zlib --enable-bzlib --enable-lzma; \
    make -j"$(nproc)"; \
    make install; \
    root=/opt/ffmpeg-debian11; \
    libdir=/usr/lib/aarch64-linux-gnu; \
    copy_lib() { \
        name="$1"; \
        if [ -e "$root/lib/$name" ]; then return 0; fi; \
        src=""; \
        for d in "$libdir" /lib/aarch64-linux-gnu; do \
            if [ -e "$d/$name" ]; then src="$d/$name"; break; fi; \
        done; \
        if [ -z "$src" ]; then echo "FATAL: arm64 library not found: $name" >&2; return 1; fi; \
        cp -L "$src" "$root/lib/$name"; \
        for dep in $(aarch64-linux-gnu-readelf -d "$root/lib/$name" | sed -n 's/.*Shared library: \[\(.*\)\]$/\1/p'); do \
            case "$dep" in \
                libc.so*|libm.so*|libdl.so*|libpthread.so*|librt.so*|libresolv.so*|libnsl.so*|libutil.so*|libanl.so*|libBrokenLocale.so*|libthread_db.so*|ld-linux-*|libgcc_s.so*|libstdc++.so*) ;; \
                *) copy_lib "$dep" ;; \
            esac; \
        done; \
    }; \
    for s in /opt/ffmpeg-debian11/lib/libavcodec.so.58 /opt/ffmpeg-debian11/lib/libavdevice.so.58 /opt/ffmpeg-debian11/lib/libavfilter.so.7 /opt/ffmpeg-debian11/lib/libavformat.so.58 /opt/ffmpeg-debian11/lib/libavutil.so.56 /opt/ffmpeg-debian11/lib/libswresample.so.3 /opt/ffmpeg-debian11/lib/libswscale.so.5; do \
        for dep in $(aarch64-linux-gnu-readelf -d "$s" | sed -n 's/.*Shared library: \[\(.*\)\]$/\1/p'); do \
            case "$dep" in \
                libc.so*|libm.so*|libdl.so*|libpthread.so*|librt.so*|libresolv.so*|libnsl.so*|libutil.so*|libanl.so*|libBrokenLocale.so*|libthread_db.so*|ld-linux-*|libgcc_s.so*|libstdc++.so*|libavcodec.so*|libavdevice.so*|libavfilter.so*|libavformat.so*|libavutil.so*|libswresample.so*|libswscale.so*) ;; \
                *) copy_lib "$dep" ;; \
            esac; \
        done; \
    done; \
    for s in libavcodec.so.58 libavdevice.so.58 libavfilter.so.7 libavformat.so.58 libavutil.so.56 libswresample.so.3 libswscale.so.5; do \
        ln -sf "$s" "$root/lib/${s%%.so*}.so"; \
    done; \
    rm -rf /tmp/ffmpeg; \
    test -f "$root/include/libavcodec/avcodec.h"; \
    test -f "$root/lib/libavcodec.so.58"; \
    echo "--- /opt/ffmpeg-debian11/lib ---"; ls -la "$root/lib"

# Step 6: Rockchip MPP + RGA media sysroot (glibc 2.31 baseline).
#
# Versions are pinned by config/rockchip-media/runtime-lock.json shared
# bullseye profile "mpp-1.1.0-rga-1.10.6-bullseye-v1", which all three chip
# platform profiles (rk3576.json / rk3588.json / rv1126b.json) reference.
# The same aarch64 media is built once and fanned out per chip:
#   - MPP  tag 1.1.0, commit c08762ebfadeb4e986d2fed993bc7a54862d3ebe
#     (same commit the RK3576 repro-v1 profile builds from; plain C++,
#     builds cleanly against bullseye g++-aarch64).
#   - librga official aarch64 prebuilt, commit 2b32edcb97b601b25683e2941d888c8515da6d55,
#     api_version 1.10.6_[3] — byte-identical to the file used on RK3576.
# Layout matches the media root convention: {include,lib,share/licenses}.
# Sources are cloned from GitHub during the build at pinned commits/tags
# (MPP_REVISION / RGA_REVISION are global ARGs declared above the first FROM,
# visible to this stage).

FROM rockchip-common AS media-build

RUN set -eux; \
    git clone --depth 1 --branch 1.1.0 \
      https://github.com/rockchip-linux/mpp.git /tmp/src/mpp; \
    test "$(git -C /tmp/src/mpp rev-parse HEAD)" = "${MPP_REVISION}"; \
    git init /tmp/src/librga; \
    git -C /tmp/src/librga remote add origin \
      https://github.com/airockchip/librga.git; \
    git -C /tmp/src/librga fetch --depth 1 \
      origin "${RGA_REVISION}"; \
    git -C /tmp/src/librga checkout --detach FETCH_HEAD; \
    test "$(git -C /tmp/src/librga rev-parse HEAD)" = "${RGA_REVISION}"

RUN set -eux; \
    root=/opt/rockchip-media/shared; \
    mkdir -p "$root/include/rockchip" "$root/include/rga" "$root/lib" "$root/share/licenses/rockchip-media/mpp" "$root/share/licenses/rockchip-media/librga"; \
    cmake -S /tmp/src/mpp -B /tmp/src/mpp/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SYSTEM_NAME=Linux \
        -DCMAKE_SYSTEM_PROCESSOR=aarch64 \
        -DCMAKE_C_COMPILER=aarch64-linux-gnu-gcc \
        -DCMAKE_CXX_COMPILER=aarch64-linux-gnu-g++ \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TEST=OFF; \
    cmake --build /tmp/src/mpp/build -j"$(nproc)"; \
    cp /tmp/src/mpp/build/mpp/librockchip_mpp.so* "$root/lib/"; \
    cd "$root/lib"; \
    real="$(readlink -f librockchip_mpp.so.1)"; \
    mv -f "$real" librockchip_mpp.so.0; \
    rm -f librockchip_mpp.so.1 librockchip_mpp.so; \
    ln -sf librockchip_mpp.so.0 librockchip_mpp.so.1; \
    ln -sf librockchip_mpp.so.1 librockchip_mpp.so; \
    cp /tmp/src/librga/libs/Linux/gcc-aarch64/librga.so "$root/lib/librga.so"; \
    cp /tmp/src/librga/include/*.h "$root/include/rga/"; \
    mkdir -p /tmp/src/mpp-headers && cp /tmp/src/mpp/inc/*.h /tmp/src/mpp-headers/; \
    cp /tmp/src/mpp/inc/*.h "$root/include/rockchip/"; \
    find /tmp/src/mpp/osal -name '*.h' | while read -r h; do rel="${h#/tmp/src/mpp/osal/}"; mkdir -p "$root/include/rockchip/$(dirname "$rel")"; cp "$h" "$root/include/rockchip/$rel"; done; \
    test -f "$root/include/rockchip/rk_mpi.h"; \
    test -f "$root/include/rga/im2d.h"; \
    test -f "$root/include/rga/im2d_type.h"; \
    test -L "$root/lib/librockchip_mpp.so.1"; \
    test -f "$root/lib/librockchip_mpp.so.0"; \
    aarch64-linux-gnu-readelf -d "$root/lib/librockchip_mpp.so.0" | grep -q 'soname.*librockchip_mpp\.so\.1'; \
    cp -r /tmp/src/mpp/LICENSES/. "$root/share/licenses/rockchip-media/mpp/"; \
    cp /tmp/src/librga/COPYING "$root/share/licenses/rockchip-media/librga/COPYING"; \
    test -s "$root/share/licenses/rockchip-media/librga/COPYING"; \
    ls -la "$root/lib"; \
    git -C /tmp/src/mpp show -s --format=%ct HEAD > /opt/rockchip-media/mpp-source-date-epoch

# Step 7: fan out the shared media to each chip root and verify against the
# chip platform profile (shared runtime profile "mpp-1.1.0-rga-1.10.6-bullseye-v1",
# ELF machine/soname + glibcMax 2.31). The checked-in platform profiles keep
# the Ubuntu legacy runtime profiles, so this stage rewrites them to the
# bullseye shared profile inside the image (COSMO_PLATFORM_PROFILE_DIR points
# the package flow at these image-local copies). RV1126B's profile requires a
# sealed sysroot (require_sealed_sysroot=true), so its root is sealed first
# with the pinned MPP/RGA source revisions. The per-chip roots are what
# build_rockchip_package.sh reads from builder-lock.bullseye.json.
FROM rockchip-common AS media-verify

COPY config/rknn/platforms/ /opt/cosmo/config/rknn/platforms/
COPY config/rockchip-media/ /opt/cosmo/config/rockchip-media/
COPY tools/rknn/media_sysroot_lock.py /usr/local/bin/cosmo-rockchip-media-lock
COPY --from=media-build /opt/rockchip-media/ /opt/rockchip-media/

# The checked-in platform profiles reference the Ubuntu legacy runtime
# profiles. Generate bullseye copies that point at the shared bullseye
# runtime profile so this Debian 11 builder's media can be verified.
RUN python3 - <<'PY'
import json
from pathlib import Path

shared = "mpp-1.1.0-rga-1.10.6-bullseye-v1"
for chip in ("rk3576", "rk3588", "rv1126b"):
    path = Path(f"/opt/cosmo/config/rknn/platforms/{chip}.json")
    profile = json.loads(path.read_text(encoding="utf-8"))
    profile["media"]["runtime_profile"] = shared
    path.write_text(json.dumps(profile, indent=2) + "\n", encoding="utf-8")
PY

RUN set -eux; \
    SOURCE_DATE_EPOCH="$(cat /opt/rockchip-media/mpp-source-date-epoch)"; \
    export SOURCE_DATE_EPOCH; \
    for chip in rk3576 rv1126b rk3588; do \
        mkdir -p "/opt/rockchip-media/$chip"; \
        cp -a /opt/rockchip-media/shared/. "/opt/rockchip-media/$chip/"; \
    done; \
    rm -rf /opt/rockchip-media/shared /opt/rockchip-media/mpp-source-date-epoch; \
    python3 /usr/local/bin/cosmo-rockchip-media-lock seal \
        --platform-profile /opt/cosmo/config/rknn/platforms/rv1126b.json \
        --root /opt/rockchip-media/rv1126b \
        --source "mpp=${MPP_REVISION}" \
        --source "rga=${RGA_REVISION}"; \
    for chip in rk3576 rk3588 rv1126b; do \
        python3 /usr/local/bin/cosmo-rockchip-media-lock verify \
            --platform-profile "/opt/cosmo/config/rknn/platforms/${chip}.json" \
            --root "/opt/rockchip-media/${chip}"; \
    done; \
    for chip in rk3576 rv1126b rk3588; do \
        test -f "/opt/rockchip-media/$chip/include/rockchip/rk_mpi.h"; \
        test -f "/opt/rockchip-media/$chip/include/rga/im2d.h"; \
        test -f "/opt/rockchip-media/$chip/lib/librockchip_mpp.so"; \
        test -f "/opt/rockchip-media/$chip/lib/librga.so"; \
    done

# Step 8: final builder image carrying all three chip media roots + RKLLM +
# builder lock + frozen version record.
FROM rockchip-common AS builder

COPY --from=media-verify /opt/rockchip-media/ /opt/rockchip-media/
COPY --from=media-verify /opt/cosmo/config/ /opt/cosmo/config/

# RKLLM Runtime v1.3.0 (aarch64) baked into the single builder image so every
# chip's produced package can carry the Qwen3.5 VLM backend (rkllm_required
# per target in builder-lock.json).
COPY scripts/install_rkllm_sdk.py /tmp/install_rkllm_sdk.py
RUN set -eux; \
    python3 -I -B /tmp/install_rkllm_sdk.py --root /opt/rkllm; \
    rm -f /tmp/install_rkllm_sdk.py; \
    test -f /opt/rkllm/include/rkllm.h; \
    test -f /opt/rkllm/lib/librkllmrt.so; \
    test -f /opt/rkllm/LICENSE

# Builder lock for the package flow. The Debian 11 builder uses the dedicated
# bullseye lock (three chips -> shared bullseye media profile); the package
# script byte-compares it against the image-side copy resolved through
# COSMO_ROCKCHIP_BUILDER_LOCK, and COSMO_PLATFORM_PROFILE_DIR makes the
# package flow read the image-local bullseye platform profiles instead of the
# checked-in Ubuntu legacy ones.
COPY config/rockchip-build/builder-lock.bullseye.json /opt/cosmo/rockchip-builder-lock.json
ENV COSMO_ROCKCHIP_BUILDER_LOCK=/opt/cosmo/rockchip-builder-lock.json \
    COSMO_PLATFORM_PROFILE_DIR=/opt/cosmo/config/rknn/platforms \
    RKNN_ROOT=/opt/rknn \
    RKLLM_ROOT=/opt/rkllm \
    COSMO_FFMPEG_ROOT=/opt/ffmpeg-debian11 \
    ROCKCHIP_MEDIA_ROOT=/opt/rockchip-media/rk3588 \
    COSMO_TARGET_CHIP=rk3588

# Record frozen tool identities for evidence/reproducibility.
RUN set -eux; \
    python3 - <<'PYEOF'
import json, re, subprocess

def out(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()

# FFmpeg is self-built LGPL 4.4.6; report the pinned release identity and the
# LGPL build flags instead of a Debian binary-package version.
ffmpeg_root = "/opt/ffmpeg-debian11"
ffmpeg_ident = out(
    f"grep -a -o 'libavcodec license: LGPL version 2.1 or later' "
    f"{ffmpeg_root}/lib/libavcodec.so.58 | head -1"
)
record = {
    "base_image": "debian:bullseye@sha256:99cdf7792e25416bd801861ccd8e2fb27fb527b25e8d9a8704ebc3ead2015675",
    "build_mode": "from-scratch",
    "media_runtime_profile": "mpp-1.1.0-rga-1.10.6-bullseye-v1",
    "rknn_runtime_sha256": "d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8",
    "rknn_include_header": "/opt/rknn/include/rknn_api.h",
    "ffmpeg_root": ffmpeg_root,
    "ffmpeg_version": "4.4.6",
    "ffmpeg_source": "https://ffmpeg.org/releases/ffmpeg-4.4.6.tar.xz",
    "ffmpeg_sha256": "2290461f467c08ab801731ed412d8e724a5511d6c33173654bd9c1d2e25d0617",
    "ffmpeg_license_build": "lgpl",
    "ffmpeg_license_identity": ffmpeg_ident,
    "cmake": out("cmake --version | head -1"),
    "cross_gcc": out("aarch64-linux-gnu-gcc --version | head -1"),
    "node": out("node --version"),
    "rustc": out("rustc --version"),
    "cargo": out("cargo --version"),
    "glibc_baseline": "2.31",
}
with open("/opt/cosmo/builder-versions.json", "w") as f:
    json.dump(record, f, indent=2)
print(json.dumps(record, indent=2))
PYEOF

WORKDIR /workspace
