# syntax=docker/dockerfile:1.7

# CosmoEdge AX650N build environment.
#
# Unlike Rockchip/Sophon (prebuilt SDK images on ghcr.io), the AX650 SDK is
# NDA-licensed and cannot be published to a public registry. This image
# therefore only carries the generic build tooling; the SDK (msp/out) and the
# ARM GNU toolchain are bind-mounted into the container by
# docker-compose.axera.yml from the host WSL checkout:
#   /opt/axera/sdk/msp-out         (AX650 SDK V3.10.2 SoC runtime)
#   /opt/axera/toolchain/gcc-arm-9.2
# scripts/build_axera_package.ps1 resolves the \\wsl$\<distro> path so Docker
# Desktop on Windows can mount them.

ARG AXERA_BASE_IMAGE=ubuntu:22.04
FROM ${AXERA_BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

# Use the Aliyun HTTP mirror (base image lacks fresh CA bundles for HTTPS
# mirrors; HTTP works reliably and the project already mirrors to Aliyun).
RUN set -eux; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list; \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        file \
        git \
        jq \
        libssl-dev \
        libtool \
        ninja-build \
        pkg-config \
        python3 \
        python3-pip \
        rsync \
        unzip \
        xz-utils \
        zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*

# Modern Node.js (>=18): the frontend uses node:assert/strict imports that
# require node >= 14.18; Ubuntu 22.04 ships node 12 via npm. Install Node 20
# from the NodeSource APT repo (mirrored to Aliyun for reachability).
RUN set -eux; \
    curl -fsSL https://deb.nodesource.com/setup_20.x -o /tmp/nodesource_setup.sh; \
    bash /tmp/nodesource_setup.sh; \
    rm -f /tmp/nodesource_setup.sh; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*; \
    node --version; \
    npm --version

# tokenizers-c builds a Rust staticlib via cargo; bootstrap rustup (stable)
# with the aarch64-unknown-linux-gnu target for cross-linking.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUSTUP_DIST_SERVER=https://rsproxy.cn \
    RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://rsproxy.cn/rustup-init.sh \
        -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal --default-toolchain stable; \
    rm -f /tmp/rustup-init.sh; \
    rustup target add aarch64-unknown-linux-gnu; \
    cargo --version; \
    rustc --version

# Builder lock consumed by scripts/build_axera_package.sh.
COPY config/axera-build/builder-lock.json /opt/cosmo/axera-builder-lock.json

ENV AXERA_ROOT=/opt/axera/sdk/msp-out \
    COSMO_TARGET_CHIP=ax650n \
    COSMO_AXERA_ROOT=/opt/axera/sdk/msp-out

WORKDIR /workspace
CMD ["/bin/bash"]
